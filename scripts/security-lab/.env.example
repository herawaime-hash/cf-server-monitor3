# Security lab environment defaults
TZ=UTC
LAB_NAME=ipad-vps-security-lab

# Mandatory legal acknowledgement at run time:
# I_HAVE_AUTHORIZATION
LEGAL_ACKNOWLEDGEMENT=

# Guardrails
DEFAULT_RATE_LIMIT=50
DEFAULT_CONCURRENCY=10

# Pin image tags for reproducible deployments
ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:2.16.1
NUCLEI_IMAGE=projectdiscovery/nuclei:v3.4.10
HTTPX_IMAGE=projectdiscovery/httpx:v1.7.1
FFUF_IMAGE=ghcr.io/ffuf/ffuf:v2.1.0
SUBFINDER_IMAGE=projectdiscovery/subfinder:v2.9.0
AMASS_IMAGE=caffix/amass:v4.2.0
NEWMAN_IMAGE=postman/newman:6.1.3-alpine
K6_IMAGE=grafana/k6:0.51.0
NMAP_IMAGE=instrumentisto/nmap:7.95

# Optional notification placeholders
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
