# Security lab environment defaults
TZ=UTC
LAB_NAME=ipad-vps-security-lab

# Mandatory legal acknowledgement at run time:
# I_HAVE_AUTHORIZATION
LEGAL_ACKNOWLEDGEMENT=

# Guardrails
DEFAULT_RATE_LIMIT=50
DEFAULT_CONCURRENCY=10

# Optional notification placeholders
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
